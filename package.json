{
  "name": "macau-heritage-trees",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "澳門古樹保育研究平台 — 資料庫 Supabase (PostgreSQL)、部署 Vercel Serverless Functions",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test tests/*.test.js",
    "test:analysis": "node --test tests/analysis.test.js",
    "test:sql": "node --test tests/sql.test.js",
    "test:api": "node --test tests/api.test.js",
    "test:security": "node --test tests/api-security.test.js",
    "test:secrets": "node --test tests/secrets.test.js",
    "test:iam": "node --test tests/iam.test.js",
    "test:ui": "node --test tests/ui.test.js",
    "test:field": "node --test tests/field.test.js",
    "test:router": "node --test tests/router.test.js",
    "test:diagnostics": "node --test tests/diagnostics.test.js",
    "test:qr": "node --test tests/qr.test.js",
    "test:card": "node --test tests/card.test.js",
    "test:supabase-path": "node --test tests/supabase-path.test.js",
    "test:pwa": "node --test tests/pwa.test.js",
    "test:priority": "node --test tests/priority.test.js",
    "qr:verify": "node scripts/qr-roundtrip.mjs && python3 scripts/qr-decode.py .qr-check",
    "build:sw": "node scripts/build-sw.mjs",
    "pwa:check": "python3 scripts/pwa-check.py",
    "verify": "npm run check && npm test",
    "vendor": "node scripts/vendor.mjs",
    "build:data": "python3 scripts/content.py && python3 scripts/build_seed.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}
